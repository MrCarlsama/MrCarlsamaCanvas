{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Least-privilege desktop access for the main MrCarlsama Canvas window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-write-text-file"
  ]
}
